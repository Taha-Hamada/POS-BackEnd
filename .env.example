# ── الخادم ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ── قاعدة البيانات ────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/pos_system

# ── المصادقة ──────────────────────────────────────────────────────────────
# غيّر السرّين دول قبل أي نشر حقيقي
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS ──────────────────────────────────────────────────────────────────
# قائمة مفصولة بفواصل، أو * للسماح للكل في التطوير
CORS_ORIGINS=*

# ── حدود المعدل ───────────────────────────────────────────────────────────
# الحد لكل عنوان IP. كل أجهزة الكاشير في المحل بتطلع من نفس العنوان،
# وشاشة البيع الواحدة بتعمل طلبات كتير في الدقيقة، فالحد الواطي بيقفل المحل.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=3000

# ── إعدادات المتجر الافتراضية ─────────────────────────────────────────────
DEFAULT_TAX_RATE=0.14
DEFAULT_CURRENCY=EGP
